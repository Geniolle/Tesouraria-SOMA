# Gmail Configuration
GMAIL_ACCOUNT_EMAIL=user@gmail.com
GMAIL_SENDER_EMAIL=noreply@montepio.pt
GMAIL_SEARCH_QUERY=in:inbox from:noreply@montepio.pt has:attachment
GMAIL_LABEL_NAME=Serviços/Banco/Montepio24/MT940

# Google Sheets Configuration
SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
SHEETS_SHEET_NAME=Transactions
SHEETS_SERVICE_ACCOUNT_PATH=credentials/sheets-service-account.json

# Verbo Café Process
# Source spreadsheet is separate from the main treasury spreadsheet; the Sheets
# service account needs Editor access (rows are read and their status written
# back). Sheet names default to the legacy Apps Script values.
VERBO_CAFE_SOURCE_SPREADSHEET_ID=11sUHhTzKaV21uX_FpBOEnJxNpFjUn6EHEiU79Pe3jXU
VERBO_CAFE_VENDAS_SHEET_NAME=VC_VENDAS
VERBO_CAFE_PAGAMENTOS_SHEET_NAME=Financeiro
# Optional: dedicated service account JSON for the Verbo Café spreadsheet.
# Leave blank to reuse SHEETS_SERVICE_ACCOUNT_PATH.
VERBO_CAFE_SERVICE_ACCOUNT_PATH=

# Gmail OAuth Credentials
GMAIL_CREDENTIALS_PATH=credentials/gmail-oauth-token.json
GMAIL_CLIENT_SECRETS_PATH=credentials/gmail-client-secret.json

# Application Behavior
ATTACHMENT_EXTENSION=.txt
BATCH_SIZE=100
LOG_LEVEL=INFO
LOG_FILE=logs/gmail-to-sheets.log

# Processing
SKIP_IF_DUPLICATE=true
ARCHIVE_AFTER_PROCESS=true
TIMEZONE=Europe/Lisbon

# Cash Balance Update (Montepio account final balance)
CASH_BALANCE_UPDATE_ENABLED=true
CASH_BALANCE_SHEET_NAME=GERENCIAR CAIXAS
CASH_BALANCE_ACCOUNT_LABEL=CAIXA ECONÔMICA MONTEPIO GERAL - CC
CASH_BALANCE_HEADER_ROW=1
CASH_BALANCE_ROW_OFFSET=1
CASH_BALANCE_VERIFY_AFTER_WRITE=true
